{
	/* Use the project's TypeScript version (5.9+) for correct moduleResolution:Bundler support */
	"typescript.tsdk": "node_modules/typescript/lib",
	/* JSON schemas */
	"json.schemas": [
		{
			"fileMatch": [
				"**/manifest.json"
			],
			"url": "https://schemas.elgato.com/streamdeck/plugins/manifest.json"
		},
		{
			"fileMatch": [
				"**/layouts/*.json"
			],
			"url": "https://schemas.elgato.com/streamdeck/plugins/layout.json"
		}
	]
}