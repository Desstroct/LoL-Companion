{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/layout.json",
	"id": "cs-tracker",
	"items": [
		{
			"key": "title",
			"type": "text",
			"rect": [4, 0, 196, 18],
			"font": { "size": 11, "weight": 600 },
			"alignment": "left",
			"color": "#C89B3C"
		},
		{
			"key": "cs_line",
			"type": "text",
			"rect": [4, 18, 196, 26],
			"font": { "size": 18, "weight": 700 },
			"alignment": "left"
		},
		{
			"key": "delta_text",
			"type": "text",
			"rect": [4, 44, 196, 20],
			"font": { "size": 14, "weight": 700 },
			"alignment": "left"
		},
		{
			"key": "cs_bar",
			"type": "bar",
			"rect": [4, 66, 192, 10],
			"range": { "min": 0, "max": 100 },
			"value": 50,
			"bar_fill_c": "#2ECC71",
			"bar_bg_c": "#E74C3C"
		},
		{
			"key": "info_text",
			"type": "text",
			"rect": [4, 78, 196, 18],
			"font": { "size": 10, "weight": 600 },
			"alignment": "left",
			"color": "#999999"
		}
	]
}
