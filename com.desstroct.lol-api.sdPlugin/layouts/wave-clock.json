{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/layout.json",
	"id": "wave-clock",
	"items": [
		{
			"key": "title",
			"type": "text",
			"rect": [4, 0, 196, 20],
			"font": { "size": 12, "weight": 600 },
			"alignment": "left",
			"color": "#C89B3C"
		},
		{
			"key": "next_wave",
			"type": "text",
			"rect": [4, 20, 196, 28],
			"font": { "size": 20, "weight": 700 },
			"alignment": "left"
		},
		{
			"key": "wave_bar",
			"type": "bar",
			"rect": [4, 50, 192, 12],
			"range": { "min": 0, "max": 100 },
			"value": 0,
			"bar_fill_c": "#C89B3C",
			"bar_bg_c": "#333333"
		},
		{
			"key": "upcoming",
			"type": "text",
			"rect": [4, 64, 196, 16],
			"font": { "size": 10, "weight": 600 },
			"alignment": "left",
			"color": "#999999"
		},
		{
			"key": "advice",
			"type": "text",
			"rect": [4, 80, 196, 16],
			"font": { "size": 11, "weight": 700 },
			"alignment": "left"
		}
	]
}
