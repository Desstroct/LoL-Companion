{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/layout.json",
	"id": "otp",
	"items": [
		{
			"key": "champ_icon",
			"type": "pixmap",
			"rect": [4, 10, 72, 72]
		},
		{
			"key": "title",
			"type": "text",
			"rect": [82, 0, 118, 22],
			"font": { "size": 13, "weight": 600 },
			"alignment": "left",
			"color": "#C89B3C"
		},
		{
			"key": "champ_name",
			"type": "text",
			"rect": [82, 22, 118, 26],
			"font": { "size": 15, "weight": 700 },
			"alignment": "left"
		},
		{
			"key": "info_text",
			"type": "text",
			"rect": [82, 48, 118, 20],
			"font": { "size": 11 },
			"alignment": "left",
			"color": "#AAAAAA"
		},
		{
			"key": "matchup_bar",
			"type": "bar",
			"rect": [82, 74, 108, 16],
			"range": { "min": 35, "max": 65 },
			"value": 50,
			"bar_fill_c": "#C89B3C",
			"bar_bg_c": "#333333"
		},
		{
			"key": "status_text",
			"type": "text",
			"rect": [82, 74, 108, 16],
			"font": { "size": 9 },
			"alignment": "right",
			"color": "#888888"
		}
	]
}
