{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/layout.json",
	"id": "objective-timer",
	"items": [
		{
			"key": "obj_icon",
			"type": "pixmap",
			"rect": [4, 4, 48, 48]
		},
		{
			"key": "title",
			"type": "text",
			"rect": [48, 6, 148, 22],
			"font": { "size": 14, "weight": 700 },
			"alignment": "left"
		},
		{
			"key": "timer_text",
			"type": "text",
			"rect": [48, 28, 100, 22],
			"font": { "size": 18, "weight": 700 },
			"alignment": "left",
			"color": "#FFFFFF"
		},
		{
			"key": "next_text",
			"type": "text",
			"rect": [4, 52, 192, 18],
			"font": { "size": 11, "weight": 400 },
			"alignment": "left",
			"color": "#AAAAAA"
		},
		{
			"key": "timer_bar",
			"type": "bar",
			"rect": [4, 74, 190, 10],
			"range": { "min": 0, "max": 100 },
			"value": 0,
			"bar_fill_c": "#F1C40F",
			"bar_bg_c": "#333333"
		}
	]
}
